// Merge into ~/.openclaw/openclaw.json with:
//   openclaw config patch --file openclaw/openclaw.patch.json5 --dry-run   (validate only)
//   openclaw config patch --file openclaw/openclaw.patch.json5             (apply)
// Secrets are NOT in this file. GROQ_API_KEY lives in ~/.openclaw/.env.
{
  gateway: {
    mode: "local",
    bind: "loopback", // this machine only
    port: 18789,
    auth: { mode: "token" }, // set the token with `openclaw config set gateway.auth.token ...`, never in this file
    http: {
      endpoints: {
        chatCompletions: { enabled: true }, // off by default; the console talks to /v1/chat/completions
      },
    },
  },

  // OpenClaw 2026.8.2 quirk, verified on this install: `config patch` validates
  // model refs through resolveCanonicalPrimaryRef, which only resolves providers
  // declared here under models.providers. The groq plugin's own catalog is not
  // loaded on that path, so every "groq/..." ref reads as "Unknown model" and the
  // whole patch is rejected - even though `openclaw models set
  // groq/openai/gpt-oss-120b`, `openclaw models status` and the Gateway all
  // resolve the same refs fine. Declaring the provider is a runtime no-op (the
  // values below mirror @openclaw/groq-provider/openclaw.plugin.json) and is what
  // makes this patch validate. `api` must be one of the schema's route ids -
  // "groq" is rejected.
  models: {
    providers: {
      groq: {
        api: "openai-completions",
        baseUrl: "https://api.groq.com/openai/v1",
      },
    },
  },

  agents: {
    defaults: {
      // Free Groq models. Fallbacks are listed here and shown in the app when used, never swapped silently.
      model: {
        primary: "groq/openai/gpt-oss-120b",
        fallbacks: ["groq/openai/gpt-oss-20b"],
      },
      // Groq's free tier is limited by tokens per day, so keep the injected
      // workspace files small. Measured on 2026-10-24, Cook, real pantry read:
      //   bootstrap 3000/9000 (all 4 files, 3209 chars) -> prompt 6,394
      //   bootstrap 1500/1500                           -> prompt 4,816
      //   bootstrap    1/400  (floor, no workspace)     -> prompt 4,962
      // The floor is OpenClaw's own system prompt plus the tool schemas, so the
      // ~5,000-token budget leaves almost no room for workspace text. 1500 keeps
      // IDENTITY.md (1278 chars) whole and drops AGENTS.md/USER.md/SOUL.md; raise
      // both values to restore them, at roughly +0.9 tokens per character.
      bootstrapMaxChars: 1500,
      bootstrapTotalMaxChars: 1500,
    },
    entries: {
      cook: {
        name: "Cooksy Cook",
        description: "Answers kitchen questions from the real pantry, recipes and week plan. Read only.",
        workspace: "C:/Users/User/Downloads/DarkCoders-OpenClaw-Assignment-Doha/DarkCoders-OpenClaw-Assignment-Doha/living-ai-talk/openclaw/agents/cook",
        identity: { name: "Cooksy" },
        skills: ["pantry", "recipes", "week-plan", "shopping", "approvals"],
        // Exact names come from `openclaw mcp probe cooksy`: OpenClaw namespaces
        // MCP tools as <server>__<tool>. Cook gets the five read tools only.
        tools: {
          profile: "minimal",
          alsoAllow: [
            "cooksy__pantry_list",
            "cooksy__recipes_search",
            "cooksy__recipes_get",
            "cooksy__plan_view",
            "cooksy__shopping_view",
          ],
        },
      },
      planner: {
        name: "Cooksy Planner",
        description: "Plans the week and changes the pantry, plan and shopping list. Every change waits for approval.",
        workspace: "C:/Users/User/Downloads/DarkCoders-OpenClaw-Assignment-Doha/DarkCoders-OpenClaw-Assignment-Doha/living-ai-talk/openclaw/agents/planner",
        identity: { name: "Cooksy" },
        skills: ["pantry", "recipes", "week-plan", "shopping", "approvals"],
        // Read tools plus the six gated ones. A gated call never writes: the API
        // stores a pending approval and returns approval_required.
        tools: {
          profile: "minimal",
          alsoAllow: [
            "cooksy__pantry_list",
            "cooksy__recipes_search",
            "cooksy__recipes_get",
            "cooksy__plan_view",
            "cooksy__shopping_view",
            "cooksy__pantry_update",
            "cooksy__pantry_remove",
            "cooksy__plan_set_meal",
            "cooksy__plan_clear_day",
            "cooksy__shopping_build",
            "cooksy__shopping_export",
          ],
        },
      },
    },
  },

  // Our own tools, served by the MCP server in api/ (built in Phase 1). Exact tool names come from the probe.
  mcp: {
    servers: {
      cooksy: {
        command: "node",
        args: [
          "C:/Users/User/Downloads/DarkCoders-OpenClaw-Assignment-Doha/DarkCoders-OpenClaw-Assignment-Doha/living-ai-talk/api/mcp-server.mjs",
        ],
        // No secrets in this file. OpenClaw substitutes ${VAR} in config string
        // values at load time (docs/help/environment.md), so the agent token is
        // read from the environment the gateway loads from ~/.openclaw/.env.
        // Verified: the stored ~/.openclaw/openclaw.json keeps this literal
        // "${COOKSY_API_TOKEN}" text and never the resolved value.
        //
        // COOKSY_API_TOKEN must be in ~/.openclaw/.env.
        // COOKSY_APPROVER_TOKEN must NOT be: the gateway and every process it
        // spawns would inherit it and the two-credential gate would be void.
        //
        // COOKSY_AGENT is deliberately unset, and the open question from Phase 3
        // is now closed. OpenClaw 2026.8.2 has no per-agent MCP scoping -
        // `agents.entries.<id>.mcp` is rejected by the config schema - and MCP
        // tools are namespaced <server>__<tool> across the whole gateway, so one
        // server cannot present Cook's 5 tools and Planner's 11 at the same time.
        // The split is therefore enforced by tools.alsoAllow above. The MCP
        // server's own COOKSY_AGENT check stays available for a
        // one-agent-per-gateway deployment, where it would enforce the split at
        // the server instead of at the allowlist.
        env: {
          COOKSY_API_URL: "http://127.0.0.1:4010",
          COOKSY_API_TOKEN: "${COOKSY_API_TOKEN}",
        },
        connectionTimeoutMs: 10000,
        requestTimeoutMs: 20000,
      },
    },
  },

  // Our five skills live in this repo.
  skills: {
    load: {
      extraDirs: [
        "C:/Users/User/Downloads/DarkCoders-OpenClaw-Assignment-Doha/DarkCoders-OpenClaw-Assignment-Doha/living-ai-talk/openclaw/skills",
      ],
    },
  },

  // Agents get no shell and no file access: they only use the cooksy tools.
  tools: {
    profile: "minimal",
    deny: ["exec"],
  },
}
