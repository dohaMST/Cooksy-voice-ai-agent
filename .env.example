# Cooksy - environment template.
# Copy to .env and fill in. .env is gitignored; never commit real values.

# --- OpenClaw gateway -------------------------------------------------------
OPENCLAW_GATEWAY_URL="http://127.0.0.1:18789"
# Shared secret the gateway expects on /v1/chat/completions.
# OPENCLAW_API_KEY is accepted as a legacy alias.
OPENCLAW_GATEWAY_TOKEN=""
OPENCLAW_DEFAULT_MODEL="openclaw/cook"

# --- Speech -----------------------------------------------------------------
# Transcription: any OpenAI-compatible /audio/transcriptions endpoint.
STT_BASE_URL="https://api.groq.com/openai/v1"
STT_MODEL="whisper-large-v3-turbo"
# Synthesis is not configured here. The Kokoro URL and voice are per-browser
# settings in the console (Settings > Voice & Agents), pointing at the
# cooksy-kokoro service in docker-compose.yml by default.

# --- Cooksy API (api/) ------------------------------------------------------
COOKSY_API_URL="http://127.0.0.1:4010"
# Agent credential: read + propose only. Used by the MCP server.
COOKSY_API_TOKEN=""
# Approver credential: console only. Do NOT copy this into ~/.openclaw/.env:
# the gateway and every MCP process it spawns would inherit it, which voids
# the two-credential approval gate. It must differ from COOKSY_API_TOKEN.
COOKSY_APPROVER_TOKEN=""
# "mongo" (shipped) or "memory".
COOKSY_STORE="mongo"
# `npm start` runs from api/, so the relative path is resolved there.
COOKSY_DATA_DIR="data"

# --- MongoDB (docker compose) ----------------------------------------------
# Used by docker-compose.yml to initialise the cooksy root user.
MONGO_ROOT_PASSWORD=""
# Must match MONGO_ROOT_PASSWORD. config.mjs rejects a MONGO_URL that still
# carries the CHANGE_ME placeholder.
MONGO_URL="mongodb://cooksy:<password>@127.0.0.1:27018/cooksy?authSource=admin"

# --- Groq -------------------------------------------------------------------
# Read by this app for transcription (/api/transcribe), and by the OpenClaw
# gateway for chat, which reads it from ~/.openclaw/.env instead.
GROQ_API_KEY=""
